{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "permissions": {
    "deny": [
      "Bash(pip install * --break-system-packages)",
      "Bash(pip3 install * --break-system-packages)",
      "Bash(sudo pip *)",
      "Bash(sudo pip3 *)"
    ],
    "ask": [
      "Bash(pip *)",
      "Bash(pip3 *)"
    ]
  }
}
