# Brewfile.base — Core tools for any macOS machine
# Managed by Loadout

# Terminal tools
brew "git"
brew "curl"
brew "jq"
brew "ripgrep"
brew "fd"
brew "fzf"
brew "bat"
brew "eza"
brew "zoxide"
brew "tmux"

# Security
cask "1password-cli"

# Desktop apps
cask "iterm2"
cask "rectangle"
cask "raycast"

# Fonts — Nerd Font for terminal glyphs (Starship powerline/icons, iTerm2
# profiles default to JetBrainsMono NFM). Renders on the host, so devbox
# SSH sessions pick it up too.
cask "font-jetbrains-mono-nerd-font"
